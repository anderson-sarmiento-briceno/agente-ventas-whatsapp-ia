# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repositorio.
# En AWS Lambda estas mismas variables se configuran en: Configuración > Variables de entorno.

# --- Obligatorias ---
WHATSAPP_VERIFY_TOKEN=        # token que pusiste al registrar el webhook en Meta
WHATSAPP_ACCESS_TOKEN=        # token de acceso de la WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=     # ID del número de WhatsApp Business
LLM_PROVIDER=anthropic        # anthropic (Claude) u openai
ANTHROPIC_API_KEY=            # obligatoria si LLM_PROVIDER=anthropic (console.anthropic.com)
OPENAI_API_KEY=               # obligatoria si LLM_PROVIDER=openai
SPREADSHEET_ID=               # ID del Google Sheet con las hojas "inventario" y "registro_ventas"
DRIVE_CARPETA_ID=             # carpeta de Drive con fotos/videos de productos y el PDF del catálogo
NUMERO_ASESOR=                # WhatsApp del asesor que recibe los pedidos (ej. 573001234567)

# --- Opcionales (valor por defecto entre paréntesis) ---
ASESORES_AUTORIZADOS=         # (vacío = cualquiera) números separados por coma que pueden "cerrar venta"
ANTHROPIC_MODEL=              # (claude-haiku-5-5)
OPENAI_MODEL=                 # (gpt-4o-mini)
GOOGLE_CREDENTIALS_FILE=      # (credentials.json) cuenta de servicio de Google
GOOGLE_CREDENTIALS_JSON=      # alternativa al archivo: el JSON completo (lo llena Secrets Manager en AWS)
SECRETO_ID=                   # solo en AWS (plan de pago): nombre del secreto en Secrets Manager
HOJA_INVENTARIO=              # (inventario)
HOJA_VENTAS=                  # (registro_ventas)
DYNAMODB_TABLA=               # (contexto_bot_will)
CONTEXTO_TTL_SEG=             # (86400) la conversación se olvida tras 24 h
CACHE_INVENTARIO_SEG=         # (300) caché del inventario
PAUSA_MEDIA_SEG=              # (1.8) espera entre fotos y texto del producto
NOMBRE_TIENDA=                # (Accesorios MotoPro)
WHATSAPP_API_VERSION=         # (v18.0)
LOG_LEVEL=                    # (INFO)
PORT=                         # (5000) solo para ejecución local
